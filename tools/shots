#!/usr/bin/env python3
"""shots — take a creation step's screenshots in GitHub Actions (CREATIONS.md §3).

Usage (from the creation's worktree):
  tools/shots <slug> <NN> [--anchor '#section'] [--full-page]

Pushes the current state of creations/<slug>/ (committed or not) as a scratch commit on
shots/<slug>-<NN>, runs .github/workflows/creation-shots.yml against it, downloads
<NN>.webp and <NN>-m.webp into creations/<slug>/steps/, then deletes the scratch branch.
The step commit itself is still made locally, with the images in it.

Stdlib only. Needs `git` and an authenticated `gh`.
"""
import argparse, json, os, re, subprocess, sys, tempfile, time

WORKFLOW = 'creation-shots.yml'


def run(*args, env=None, capture=True):
    result = subprocess.run(args, env=env, text=True, capture_output=capture)
    if result.returncode != 0:
        sys.exit(f"shots: {' '.join(args)} failed\n{result.stderr or ''}")
    return (result.stdout or '').strip()


def scratch_commit(slug, step):
    """Commit HEAD plus the working copy of creations/<slug>/, without touching the real index."""
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, 'GIT_INDEX_FILE': os.path.join(tmp, 'index')}
        run('git', 'read-tree', 'HEAD', env=env)
        run('git', 'add', '-A', '--', f'creations/{slug}/', env=env)
        tree = run('git', 'write-tree', env=env)
    return run('git', 'commit-tree', tree, '-p', 'HEAD', '-m', f'shots {slug} step {step} (scratch)')


def find_run(title, since):
    for _ in range(30):
        runs = json.loads(run('gh', 'run', 'list', '--workflow', WORKFLOW, '--event', 'workflow_dispatch',
                              '--limit', '20', '--json', 'databaseId,displayTitle,createdAt'))
        for r in runs:
            if r['displayTitle'] == title and r['createdAt'] >= since:
                return r['databaseId']
        time.sleep(2)
    sys.exit('shots: the workflow run never showed up')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('slug')
    parser.add_argument('step')
    parser.add_argument('--anchor', default='')
    parser.add_argument('--full-page', action='store_true')
    args = parser.parse_args()

    if not re.fullmatch(r'[a-z0-9-]+', args.slug) or not re.fullmatch(r'\d{2}', args.step):
        sys.exit('shots: slug is lowercase-kebab and step is two digits, e.g. tools/shots prism 03')
    os.chdir(run('git', 'rev-parse', '--show-toplevel'))
    steps_dir = f'creations/{args.slug}/steps'
    if not os.path.isfile(f'creations/{args.slug}/index.html'):
        sys.exit(f'shots: creations/{args.slug}/index.html not found')

    branch = f'shots/{args.slug}-{args.step}'
    title = f'shots {args.slug} step {args.step} ({branch})'
    commit = scratch_commit(args.slug, args.step)
    run('git', 'push', '--force', '--quiet', 'origin', f'{commit}:refs/heads/{branch}')
    try:
        since = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(time.time() - 5))
        run('gh', 'workflow', 'run', WORKFLOW, '--ref', 'master', '-f', f'ref={branch}', '-f', f'slug={args.slug}',
            '-f', f'step={args.step}', '-f', f'anchor={args.anchor}', '-f', f'full_page={str(args.full_page).lower()}')
        run_id = str(find_run(title, since))
        print(f'shots: waiting for run {run_id}…', file=sys.stderr)
        subprocess.run(['gh', 'run', 'watch', run_id, '--exit-status', '--interval', '5'], stdout=subprocess.DEVNULL)
        os.makedirs(steps_dir, exist_ok=True)
        run('gh', 'run', 'download', run_id, '--name', f'shots-{args.slug}-{args.step}', '--dir', steps_dir)
    finally:
        subprocess.run(['git', 'push', '--quiet', 'origin', '--delete', branch], capture_output=True)

    for name in (f'{args.step}.webp', f'{args.step}-m.webp'):
        path = os.path.join(steps_dir, name)
        if not os.path.isfile(path):
            sys.exit(f'shots: {path} missing after download')
        print(path)


if __name__ == '__main__':
    main()
